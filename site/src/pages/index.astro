---
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Features,
  Hero,
  Install,
  Quickstart,
  Terminal,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import { url } from '@casoon/pages-theme/url';
import Diagram from '../components/Diagram.astro';
import { clientSize, output } from '../showcase';

const client = `import { init } from "@casoon/trackr/client";
init({ endpoint: "/api/track" });`;
---

<Base>
  <Hero
    title="Know what people read on your site, without collecting who they are."
    lead="trackr counts pageviews and events on static sites and single-page apps. A small script in the browser sends them to an endpoint on your own server, which removes personal data before anything is stored, in a database or service you pick."
  >
    <Install
      commands={[
        { label: 'pnpm', command: 'pnpm add @casoon/trackr' },
        { label: 'npm', command: 'npm install @casoon/trackr' },
      ]}
    />
    <Badges>
      <Badge>LGPL-3.0-or-later</Badge>
      <Badge>npm 0.3.0</Badge>
      <Badge>Node 22+</Badge>
    </Badges>
    <Terminal slot="output" title="what gets stored · examples/output/event.json" dots
      ><Fragment set:html={output('event')} /></Terminal
    >
  </Hero>

  <Facts
    items={[
      { value: `${clientSize.gzip} B`, label: `gzip size of the browser script (${clientSize.file})` },
      { value: '0', label: 'cookies set by the script' },
      { value: '4', label: 'places to store events: Postgres, webhook, HTTP API, GA4' },
      { value: '73', label: 'tests in the Vitest suite' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        You add the script to your site and a small endpoint to your server. Every pageview and
        every event you track goes to that endpoint first, not to a third party.
      </p>
      <p>
        The endpoint ignores bots, drops email addresses and similar personal data from URLs and
        event properties, and keeps no IP address. Then it hands the event to the storage you
        configured.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 640, height: 520 }} />
    <div class="links">
      <Button href={url('docs/')} variant="secondary">How it works in detail</Button>
      <Button href={url('docs/guides/privacy/')} variant="secondary">Privacy</Button>
      <Button href="https://trackr.casoon.de" variant="quiet">Product website →</Button>
    </div>
  </section>

  <Features
    items={[
      {
        title: 'For static sites and SPAs',
        body: 'Works with Astro and any framework whose routes take a web Request and return a Response. Page changes in single-page apps are counted too.',
      },
      {
        title: 'No cookies, no stored IP',
        body: 'The script stores nothing in the browser. On the server, visits are grouped into a session that starts fresh every day; the IP address itself is never stored.',
      },
      {
        title: 'Your data, your storage',
        body: 'Keep events in your own Postgres, forward them to a webhook or an HTTP API, or send them to GA4 from your server. You can also combine several.',
      },
      {
        title: 'Works without JavaScript',
        body: 'A tracking pixel records pageviews in emails and on pages that run no script.',
      },
    ]}
  />

  <Quickstart
    lead="Three steps from install to the first stored pageview. The full walkthrough, with the endpoint and the database table, is in the documentation."
    steps={[
      'Load the script once in your shared layout and point it at your endpoint.',
      'Add an endpoint that runs <code>createHandler()</code> with a storage adapter.',
      'Create the table with the Postgres migration from the package, or pick another adapter.',
    ]}
  >
    <CodeBlock code={client} lang="ts" label="Client" />
  </Quickstart>
</Base>

<style>
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
